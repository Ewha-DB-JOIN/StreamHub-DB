package config;

/**
 * DB 접속 정보 설정 파일
 *
 * ⚠ 사용 방법:
 *   1. 이 파일을 복사하여 같은 폴더에 DBConfig.java 로 저장
 *   2. 본인 DB 환경에 맞게 아래 값을 수정
 *   3. DBConfig.java 는 .gitignore 처리되어 있으므로 커밋되지 않음
 */
public class DBConfig {
    public static final String DB_URL  = "jdbc:mysql://<HOST>:3306/<DB_NAME>?useSSL=true&serverTimezone=Asia/Seoul";
    public static final String DB_USER = "your_mysql_user";
    public static final String DB_PASS = "your_mysql_password";
}
